# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 32

# Typed once into the phone's setup screen to pair it.
BEPRO_DEVICE_SECRET=change-me-pairing-secret
# HMAC key for access tokens, at least 32 bytes.
BEPRO_JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
# Header value Cloud Scheduler sends to POST /v1/internal/digest/run.
BEPRO_INTERNAL_TOKEN=change-me-internal-token

BEPRO_USER_ID=me
BEPRO_ZONE=Asia/Kolkata

# "rules" works offline; "vertex" calls Gemini on Vertex AI.
BEPRO_AI_PROVIDER=rules
GOOGLE_CLOUD_PROJECT=
BEPRO_VERTEX_LOCATION=global
BEPRO_VERTEX_MODEL=gemini-3.5-flash

# Run the Sunday 08:00 digest inside the server (only when it's always on, not on Cloud Run).
BEPRO_DIGEST_SCHEDULER=true
